# Copy to .env.local for local development. Set the same keys in Vercel.

# Public origin. Optional — defaults to https://abdulfullstackdev.vercel.app
NEXT_PUBLIC_SITE_URL=https://abdulfullstackdev.vercel.app

# EmailJS — server-only, used by POST /api/contact. Never prefix these with NEXT_PUBLIC_.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
